<?xml version="1.0" encoding="UTF-8"?>
<feature
   id="org.eclipse.oct.feature"
   label="Open Collaboration Tools"
   version="1.0.0.qualifier"
   provider-name="TypeFox GmbH"
   plugin="org.eclipse.oct">

   <description>
      Eclipse plugin for Open Collaboration Tools — real-time collaborative editing.
   </description>

   <copyright>
      Copyright (c) 2026 TypeFox GmbH and others.
   </copyright>

   <license url="https://www.eclipse.org/legal/epl-2.0/">
      Eclipse Public License 2.0
   </license>

   <requires>
      <import plugin="org.eclipse.core.runtime"/>
      <import plugin="org.eclipse.core.resources"/>
      <import plugin="org.eclipse.core.filesystem"/>
      <import plugin="org.eclipse.ui"/>
      <import plugin="org.eclipse.ui.ide"/>
      <import plugin="org.eclipse.jface.text"/>
      <import plugin="org.eclipse.equinox.security"/>
   </requires>

   <plugin
      id="org.eclipse.oct"
      download-size="0"
      install-size="0"
      version="0.0.0"
      unpack="false"/>

   <!-- The native oct-service-process ships per platform. The os/arch filters are
        what keep an installation down to the single binary it can run, instead of
        every platform's copy of a ~120 MB Node single-executable bundle. -->
   <plugin
      id="org.eclipse.oct.binary.linux.x86_64"
      os="linux"
      arch="x86_64"
      download-size="0"
      install-size="0"
      version="0.0.0"
      fragment="true"
      unpack="false"/>

   <plugin
      id="org.eclipse.oct.binary.win32.x86_64"
      os="win32"
      arch="x86_64"
      download-size="0"
      install-size="0"
      version="0.0.0"
      fragment="true"
      unpack="false"/>

   <plugin
      id="org.eclipse.oct.binary.macosx.aarch64"
      os="macosx"
      arch="aarch64"
      download-size="0"
      install-size="0"
      version="0.0.0"
      fragment="true"
      unpack="false"/>

</feature>
