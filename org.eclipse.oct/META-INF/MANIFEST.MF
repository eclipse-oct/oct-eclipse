Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Eclipse OCT
Bundle-SymbolicName: org.eclipse.oct;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .,
 lib/lsp4j.jsonrpc.jar,
 lib/jackson-databind.jar,
 lib/jackson-core.jar,
 lib/jackson-annotations.jar,
 lib/jackson-dataformat-msgpack.jar,
 lib/msgpack-core.jar
Bundle-Vendor: Eclipse ECD
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.equinox.common,
 org.eclipse.core.resources;bundle-version="3.14.0",
 org.eclipse.core.filesystem;bundle-version="1.9.0",
 org.eclipse.ui;bundle-version="3.200.0",
 org.eclipse.ui.ide;bundle-version="3.18.0",
 org.eclipse.ui.workbench.texteditor;bundle-version="3.16.0",
 org.eclipse.jface.text;bundle-version="3.22.0",
 org.eclipse.equinox.security;bundle-version="1.3.0",
 com.google.gson;bundle-version="2.8.0",
 org.eclipse.lsp4j;bundle-version="1.0.0"
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.eclipse.oct.internal.Activator
