<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.oct</groupId>
        <artifactId>org.eclipse.oct.parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>org.eclipse.oct</artifactId>
    <packaging>eclipse-plugin</packaging>

    <name>Eclipse OCT Plugin</name>

    <build>
        <plugins>
            <!-- Download and stage third-party jars into lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/lib</outputDirectory>
                            <stripVersion>false</stripVersion>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.msgpack</groupId>
                                    <artifactId>jackson-dataformat-msgpack</artifactId>
                                    <version>0.9.6</version>
                                    <destFileName>jackson-dataformat-msgpack.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.msgpack</groupId>
                                    <artifactId>msgpack-core</artifactId>
                                    <version>0.9.6</version>
                                    <destFileName>msgpack-core.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build the native oct-service-process executable via npm, then stage it into
                 oct-bin/ so ServiceProcess.EXECUTABLE_BASE ("oct-bin/oct-service-process") can
                 extract it from the packaged bundle at runtime.
                 Requires Node.js 20+ and the sibling open-collaboration-tools checkout at
                 -Doct.project.path=... (defaulted in the parent pom). Hard-fails if npm or the
                 build script is unavailable. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-service-process-executable</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Building oct-service-process native executable (oct.project.path=${oct.project.path})"/>
                                <condition property="npm.executable" value="npm.cmd" else="npm">
                                    <os family="windows"/>
                                </condition>
                                <exec executable="${npm.executable}" dir="${oct.project.path}" failonerror="true">
                                    <arg value="install"/>
                                </exec>
                                <!-- Build every workspace so the server bundle (needed by the
                                     integration tests) and service-process bundle are both up to date. -->
                                <exec executable="${npm.executable}" dir="${oct.project.path}" failonerror="true">
                                    <arg value="run"/>
                                    <arg value="build"/>
                                </exec>
                                <exec executable="${npm.executable}" dir="${oct.project.path}" failonerror="true">
                                    <arg value="run"/>
                                    <arg value="create:executable"/>
                                    <arg value="--workspace=open-collaboration-service-process"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-executables</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Staging oct-service-process binaries into oct-bin/ (oct.project.path=${oct.project.path})"/>
                                <!-- Wipe first: ServiceProcess prefers oct-service-process-&lt;platform&gt;
                                     over the unsuffixed name. create:executable only emits
                                     oct-service-process, so a leftover
                                     oct-service-process-darwin-arm64 from an older build would
                                     silently win at runtime and keep Eclipse on stale code. -->
                                <delete>
                                    <fileset dir="${project.basedir}/oct-bin" includes="oct-service-process*" erroronmissingdir="false"/>
                                </delete>
                                <copy todir="${project.basedir}/oct-bin" failonerror="true">
                                    <fileset dir="${oct.project.path}/packages/open-collaboration-service-process/bin"
                                             includes="oct-service-process*" erroronmissingdir="true"/>
                                </copy>
                                <chmod file="${project.basedir}/oct-bin/oct-service-process" perm="ugo+rx" osfamily="unix"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- These are used for compile only; runtime jars come from lib/ in bundle classpath -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.msgpack</groupId>
            <artifactId>jackson-dataformat-msgpack</artifactId>
            <version>0.9.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
