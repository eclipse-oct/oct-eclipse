<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.oct</groupId>
        <artifactId>org.eclipse.oct.parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>org.eclipse.oct</artifactId>
    <packaging>eclipse-plugin</packaging>

    <name>Eclipse OCT Plugin</name>

    <build>
        <plugins>
            <!-- Download and stage third-party jars into lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/lib</outputDirectory>
                            <stripVersion>false</stripVersion>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.msgpack</groupId>
                                    <artifactId>jackson-dataformat-msgpack</artifactId>
                                    <version>0.9.6</version>
                                    <destFileName>jackson-dataformat-msgpack.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.msgpack</groupId>
                                    <artifactId>msgpack-core</artifactId>
                                    <version>0.9.6</version>
                                    <destFileName>msgpack-core.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build the sibling open-collaboration-tools checkout. Unconditional,
                 and not only about the service process: the integration tests start
                 that project's OCT server from the very same build output.
                 Requires Node.js 20+ and the checkout at -Doct.project.path=...
                 (defaulted in the parent pom). Hard-fails if npm or the build script
                 is unavailable. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-open-collaboration-tools</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Building open-collaboration-tools (oct.project.path=${oct.project.path})"/>
                                <condition property="npm.executable" value="npm.cmd" else="npm">
                                    <os family="windows"/>
                                </condition>
                                <exec executable="${npm.executable}" dir="${oct.project.path}" failonerror="true">
                                    <arg value="install"/>
                                </exec>
                                <!-- Every workspace, so the server bundle (needed by the
                                     integration tests) is up to date too. -->
                                <exec executable="${npm.executable}" dir="${oct.project.path}" failonerror="true">
                                    <arg value="run"/>
                                    <arg value="build"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Active unless -Doct.binaries.dir points at pre-built binaries (see the
             parent pom): produce the native executable for this machine only. The
             org.eclipse.oct.binary.* fragments then pick it up from there — this
             bundle itself carries no executable, so that an installation can never
             end up with a binary for the wrong platform. -->
        <profile>
            <id>native-executable-from-source</id>
            <activation>
                <property>
                    <name>!oct.binaries.dir</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>create-native-executable</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <echo message="Building oct-service-process as ${oct.local.binary.name}"/>
                                        <condition property="npm.executable" value="npm.cmd" else="npm">
                                            <os family="windows"/>
                                        </condition>
                                        <exec executable="${npm.executable}" dir="${oct.project.path}" failonerror="true">
                                            <arg value="run"/>
                                            <arg value="create:executable"/>
                                            <arg value="--workspace=open-collaboration-service-process"/>
                                        </exec>
                                        <!-- create:executable always emits the same unsuffixed name.
                                             Renaming it to the platform-suffixed one is what lets the
                                             fragments pick binaries up by a fixed name, and matches
                                             how ServiceProcess looks the binary up at runtime. Driven
                                             by a fileset so that the name that does not exist on this
                                             platform is skipped silently rather than warned about. -->
                                        <move todir="${oct.binaries.dir}">
                                            <fileset dir="${oct.binaries.dir}"
                                                     includes="oct-service-process,oct-service-process.exe"/>
                                            <mapper type="merge" to="${oct.local.binary.name}"/>
                                        </move>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <!-- These are used for compile only; runtime jars come from lib/ in bundle classpath -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.msgpack</groupId>
            <artifactId>jackson-dataformat-msgpack</artifactId>
            <version>0.9.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
